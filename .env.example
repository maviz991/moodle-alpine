# ==============================================================================
# Moodle Docker - Variáveis de Ambiente
# Copie este arquivo para .env e configure os valores
# ==============================================================================

# ------------------------------------------------------------------------------
# MOODLE
# ------------------------------------------------------------------------------
# URL de acesso ao Moodle (com https://)
MOODLE_WWWROOT=https://moodle.example.com

# Salt para hashes de senha (gere com: openssl rand -hex 32)
MOODLE_PASSWORD_SALT=

# Chave de upgrade (opcional, para upgrades via CLI)
MOODLE_UPGRADE_KEY=

# ------------------------------------------------------------------------------
# BANCO DE DADOS (MySQL/MariaDB)
# ------------------------------------------------------------------------------
# Nome do banco de dados
MOODLE_DB_NAME=moodle

# Usuário do banco de dados
MOODLE_DB_USER=moodle

# Senha do banco de dados (use senha forte!)
# Gere com: openssl rand -base64 32
MOODLE_DB_PASSWORD=

# Senha root do MySQL (apenas para desenvolvimento)
MYSQL_ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# REDIS (Cache de Sessão)
# ------------------------------------------------------------------------------
# Senha do Redis (opcional, mas recomendado)
# Gere com: openssl rand -base64 32
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# DEBUG (APENAS DESENVOLVIMENTO!)
# ------------------------------------------------------------------------------
# Habilita debug do Moodle (NUNCA em produção!)
# MOODLE_DEBUG=true
