# ==============================================================================
# Dockerfile para Moodle Seguro com Plugins
# Base: PHP 8.2 FPM Alpine (menor superfície de ataque)
# Banco de Dados: MySQL/MariaDB externo ao container
# ==============================================================================

ARG MOODLE_VERSION=405
ARG PHP_VERSION=8.2

# ==============================================================================
# STAGE 1: Builder - Instala plugins
# ==============================================================================
FROM php:${PHP_VERSION}-fpm-alpine AS builder

ARG MOODLE_VERSION

# Instala certificado CA do FortiGate (SSL inspection proxy)
COPY config/fortigate_proxy.crt /usr/local/share/ca-certificates/
RUN cat /usr/local/share/ca-certificates/fortigate_proxy.crt >> /etc/ssl/certs/ca-certificates.crt

# Instala dependências para download de plugins
RUN apk add --no-cache \
    curl \
    git \
    jq \
    unzip \
    tar \
    bash

WORKDIR /build

# Download do Moodle
RUN MOODLE_DOWNLOAD_URL="https://download.moodle.org/download.php/direct/stable${MOODLE_VERSION}/moodle-latest-${MOODLE_VERSION}.tgz" \
    && curl -fSL -o moodle.tgz "${MOODLE_DOWNLOAD_URL}" \
    && mkdir -p /build/moodle \
    && tar -xzf moodle.tgz --strip-components=1 -C /build/moodle \
    && rm moodle.tgz

# Copia manifesto e script de plugins
COPY plugins/plugins.json /build/plugins/plugins.json
COPY plugins/install-plugins.sh /build/plugins/install-plugins.sh
RUN chmod +x /build/plugins/install-plugins.sh

# Instala plugins
ENV MOODLE_DIR=/build/moodle
RUN /build/plugins/install-plugins.sh install

# Lista plugins instalados para verificação
RUN /build/plugins/install-plugins.sh verify

# ==============================================================================
# STAGE 2: Runtime - Imagem final otimizada
# ==============================================================================
FROM php:${PHP_VERSION}-fpm-alpine AS runtime

LABEL maintainer="CDHU Infrastructure Team"
LABEL description="Moodle LMS - Instalação Segura com Plugins"
LABEL moodle.version="${MOODLE_VERSION}"

# ==============================================================================
# VARIÁVEIS DE AMBIENTE
# ==============================================================================
ENV MOODLE_DIR=/var/www/html
ENV MOODLEDATA_DIR=/var/moodledata
ENV PHP_EXPOSE_PHP=Off
ENV TZ=America/Sao_Paulo

# ==============================================================================
# CERTIFICADO CA DO FORTIGATE (SSL inspection proxy)
# ==============================================================================
COPY config/fortigate_proxy.crt /usr/local/share/ca-certificates/
RUN cat /usr/local/share/ca-certificates/fortigate_proxy.crt >> /etc/ssl/certs/ca-certificates.crt

# ==============================================================================
# INSTALAÇÃO DE DEPENDÊNCIAS
# ==============================================================================
RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache \
        curl \
        wget \
        unzip \
        tzdata \
        bash \
        # Bibliotecas para extensões PHP
        freetype \
        freetype-dev \
        libjpeg-turbo \
        libjpeg-turbo-dev \
        libpng \
        libpng-dev \
        libwebp \
        libwebp-dev \
        libzip \
        libzip-dev \
        libxml2 \
        libxml2-dev \
        libxslt \
        libxslt-dev \
        icu \
        icu-dev \
        icu-data-full \
        oniguruma \
        oniguruma-dev \
        openldap \
        openldap-dev \
        libsodium \
        libsodium-dev \
        # Para SAML2 plugin
        openssl \
        # Para compilação
        $PHPIZE_DEPS \
        linux-headers \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# ==============================================================================
# EXTENSÕES PHP
# ==============================================================================
RUN docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install -j$(nproc) \
        mysqli \
        pdo \
        pdo_mysql \
        gd \
        intl \
        soap \
        zip \
        opcache \
        exif \
        xsl \
        ldap \
        sodium \
    # Redis
    && pecl install redis \
    && docker-php-ext-enable redis \
    # APCu
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    # Limpeza
    && apk del --no-cache \
        freetype-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libwebp-dev \
        libzip-dev \
        libxml2-dev \
        libxslt-dev \
        icu-dev \
        oniguruma-dev \
        openldap-dev \
        libsodium-dev \
        $PHPIZE_DEPS \
        linux-headers \
    && rm -rf /tmp/* /var/cache/apk/*

# ==============================================================================
# CONFIGURAÇÕES PHP
# ==============================================================================
COPY config/php-security.ini /usr/local/etc/php/conf.d/99-security.ini
COPY config/php-moodle.ini /usr/local/etc/php/conf.d/98-moodle.ini
COPY config/opcache.ini /usr/local/etc/php/conf.d/97-opcache.ini
COPY config/php-fpm-security.conf /usr/local/etc/php-fpm.d/zz-security.conf

# ==============================================================================
# COPIA MOODLE COM PLUGINS DO BUILDER
# ==============================================================================
COPY --from=builder /build/moodle ${MOODLE_DIR}

# ==============================================================================
# PLUGINS LOCAIS (opcional - para plugins proprietários)
# Descomente se tiver plugins que não podem ser baixados automaticamente
# ==============================================================================
# COPY plugins/local/ ${MOODLE_DIR}/

# ==============================================================================
# USUÁRIO NÃO-ROOT
# ==============================================================================
RUN addgroup -g 1000 -S moodle \
    && adduser -u 1000 -S moodle -G moodle \
    && mkdir -p ${MOODLEDATA_DIR} \
    && mkdir -p /var/log/php \
    && chown -R moodle:moodle ${MOODLE_DIR} ${MOODLEDATA_DIR} /var/log/php

# ==============================================================================
# PERMISSÕES
# ==============================================================================
RUN chmod -R 755 ${MOODLE_DIR} \
    && find ${MOODLE_DIR} -type f -exec chmod 644 {} \; \
    && chmod 770 ${MOODLEDATA_DIR}

# ==============================================================================
# SCRIPTS
# ==============================================================================
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY scripts/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /usr/local/bin/healthcheck.sh

# ==============================================================================
# CONFIGURAÇÃO FINAL
# ==============================================================================
WORKDIR ${MOODLE_DIR}

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

USER moodle

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php-fpm"]
