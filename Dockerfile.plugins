# ==============================================================================
# Dockerfile para Moodle Seguro com Plugins
# Base: PHP 8.2 FPM Alpine (menor superfície de ataque)
# Banco de Dados: MySQL/MariaDB externo ao container
# ==============================================================================

ARG MOODLE_VERSION=405
ARG PHP_VERSION=8.2

# ==============================================================================
# STAGE 1: Builder - Instala plugins
# ==============================================================================
FROM php:${PHP_VERSION}-fpm-alpine AS builder

ARG MOODLE_VERSION

# ------------------------------------------------------------------------------
# PROXY (opcional - vazio por padrao, ver Dockerfile para detalhes)
# ------------------------------------------------------------------------------
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=localhost,127.0.0.1,::1
ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    NO_PROXY=${NO_PROXY}

# ------------------------------------------------------------------------------
# CAs corporativas (opcional) - qualquer .crt em config/ca/
# ------------------------------------------------------------------------------
COPY config/ca/ /tmp/ca-certs/
RUN set -eux; \
    if ls /tmp/ca-certs/*.crt >/dev/null 2>&1; then \
        mkdir -p /usr/local/share/ca-certificates; \
        cp /tmp/ca-certs/*.crt /usr/local/share/ca-certificates/; \
        cat /tmp/ca-certs/*.crt >> /etc/ssl/certs/ca-certificates.crt; \
        if command -v update-ca-certificates >/dev/null 2>&1; then \
            update-ca-certificates || true; \
        fi; \
    fi; \
    rm -rf /tmp/ca-certs

# Instala dependências para download de plugins
RUN apk add --no-cache \
    curl \
    git \
    jq \
    unzip \
    tar \
    bash

WORKDIR /build

# Download do Moodle
RUN MOODLE_DOWNLOAD_URL="https://download.moodle.org/download.php/direct/stable${MOODLE_VERSION}/moodle-latest-${MOODLE_VERSION}.tgz" \
    && curl -fSL -o moodle.tgz "${MOODLE_DOWNLOAD_URL}" \
    && mkdir -p /build/moodle \
    && tar -xzf moodle.tgz --strip-components=1 -C /build/moodle \
    && rm moodle.tgz

# Copia manifesto e script de plugins
COPY plugins/plugins.json /build/plugins/plugins.json
COPY plugins/install-plugins.sh /build/plugins/install-plugins.sh
RUN chmod +x /build/plugins/install-plugins.sh

# Instala plugins
ENV MOODLE_DIR=/build/moodle
RUN /build/plugins/install-plugins.sh install

# Lista plugins instalados para verificação
RUN /build/plugins/install-plugins.sh verify

# ==============================================================================
# STAGE 2: Runtime - Imagem final otimizada
# ==============================================================================
FROM php:${PHP_VERSION}-fpm-alpine AS runtime

LABEL maintainer="CDHU Infrastructure Team"
LABEL description="Moodle LMS - Instalação Segura com Plugins"
LABEL moodle.version="${MOODLE_VERSION}"

# ==============================================================================
# VARIÁVEIS DE AMBIENTE
# ==============================================================================
ENV MOODLE_DIR=/var/www/html
ENV MOODLEDATA_DIR=/var/moodledata
ENV PHP_EXPOSE_PHP=Off
ENV TZ=America/Sao_Paulo

# ==============================================================================
# PROXY DE BUILD (opcional) + CAs CORPORATIVAS (opcional)
# ==============================================================================
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=localhost,127.0.0.1,::1
ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    NO_PROXY=${NO_PROXY}

COPY config/ca/ /tmp/ca-certs/
RUN set -eux; \
    if ls /tmp/ca-certs/*.crt >/dev/null 2>&1; then \
        mkdir -p /usr/local/share/ca-certificates; \
        cp /tmp/ca-certs/*.crt /usr/local/share/ca-certificates/; \
        cat /tmp/ca-certs/*.crt >> /etc/ssl/certs/ca-certificates.crt; \
        if command -v update-ca-certificates >/dev/null 2>&1; then \
            update-ca-certificates || true; \
        fi; \
        echo "CA corporativas instaladas:"; ls -1 /usr/local/share/ca-certificates/; \
    else \
        echo "Nenhuma CA corporativa em config/ca/ - seguindo sem."; \
    fi; \
    rm -rf /tmp/ca-certs

# ==============================================================================
# INSTALAÇÃO DE DEPENDÊNCIAS
# ==============================================================================
RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache \
        curl \
        wget \
        unzip \
        tzdata \
        bash \
        # Bibliotecas para extensões PHP
        freetype \
        freetype-dev \
        libjpeg-turbo \
        libjpeg-turbo-dev \
        libpng \
        libpng-dev \
        libwebp \
        libwebp-dev \
        libzip \
        libzip-dev \
        libxml2 \
        libxml2-dev \
        libxslt \
        libxslt-dev \
        icu \
        icu-dev \
        icu-data-full \
        oniguruma \
        oniguruma-dev \
        openldap \
        openldap-dev \
        libsodium \
        libsodium-dev \
        # Para SAML2 plugin
        openssl \
        # Para compilação
        $PHPIZE_DEPS \
        linux-headers \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# ==============================================================================
# EXTENSÕES PHP
# ==============================================================================
RUN docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install -j$(nproc) \
        mysqli \
        pdo \
        pdo_mysql \
        gd \
        intl \
        soap \
        zip \
        opcache \
        exif \
        xsl \
        ldap \
        sodium \
    # Atualiza o canal do PECL antes de instalar: sem isso, o pecl install
    # falha às vezes com "Package does not have REST info xml available"
    # (cache/metadados do canal desatualizado, independente de proxy)
    && pecl channel-update pecl.php.net \
    # Redis
    && pecl install redis \
    && docker-php-ext-enable redis \
    # APCu
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    # Limpeza
    && apk del --no-cache \
        freetype-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libwebp-dev \
        libzip-dev \
        libxml2-dev \
        libxslt-dev \
        icu-dev \
        oniguruma-dev \
        openldap-dev \
        libsodium-dev \
        $PHPIZE_DEPS \
        linux-headers \
    && rm -rf /tmp/* /var/cache/apk/*

# ==============================================================================
# CONFIGURAÇÕES PHP
# ==============================================================================
COPY config/php-security.ini /usr/local/etc/php/conf.d/99-security.ini
COPY config/php-moodle.ini /usr/local/etc/php/conf.d/98-moodle.ini
COPY config/opcache.ini /usr/local/etc/php/conf.d/97-opcache.ini
COPY config/php-fpm-security.conf /usr/local/etc/php-fpm.d/zz-security.conf

# ==============================================================================
# COPIA MOODLE COM PLUGINS DO BUILDER
# ==============================================================================
COPY --from=builder /build/moodle ${MOODLE_DIR}

# ==============================================================================
# PLUGINS LOCAIS (opcional - para plugins proprietários)
# Descomente se tiver plugins que não podem ser baixados automaticamente
# ==============================================================================
# COPY plugins/local/ ${MOODLE_DIR}/

# ==============================================================================
# USUÁRIO NÃO-ROOT
# ==============================================================================
RUN addgroup -g 1000 -S moodle \
    && adduser -u 1000 -S moodle -G moodle \
    && mkdir -p ${MOODLEDATA_DIR} \
    && mkdir -p /var/log/php \
    && chown -R moodle:moodle ${MOODLE_DIR} ${MOODLEDATA_DIR} /var/log/php

# ==============================================================================
# PERMISSÕES
# ==============================================================================
RUN chmod -R 755 ${MOODLE_DIR} \
    && find ${MOODLE_DIR} -type f -exec chmod 644 {} \; \
    && chmod 770 ${MOODLEDATA_DIR}

# ==============================================================================
# SCRIPTS
# ==============================================================================
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY scripts/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /usr/local/bin/healthcheck.sh

# ==============================================================================
# CONFIGURAÇÃO FINAL
# ==============================================================================
# Limpa o proxy de build (so necessario durante o build, nao em runtime)
ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY= \
    no_proxy= \
    NO_PROXY=

WORKDIR ${MOODLE_DIR}

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

USER moodle

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php-fpm"]
