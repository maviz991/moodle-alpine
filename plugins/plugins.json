{
    "$schema": "./plugins-schema.json",
    "_comment": "Manifesto de plugins do Moodle - CDHU",
    "_updated": "2026-01-26",

    "plugins": [
        {
            "name": "mod_coursecertificate",
            "description": "Course Certificate - Issue certificates to students",
            "type": "mod",
            "source": "github",
            "repo": "moodleworkplace/moodle-mod_coursecertificate",
            "version": "v4.5.7",
            "enabled": true
        },
        {
            "name": "mod_hvp",
            "description": "H5P Interactive Content",
            "type": "mod",
            "source": "github",
            "repo": "h5p/moodle-mod_hvp",
            "version": "1.27.3",
            "enabled": true
        },
        {
            "name": "block_listacursos",
            "description": "Lista de Cursos Block",
            "type": "block",
            "source": "url",
            "url": "",
            "version": "1.1",
            "enabled": false,
            "_comment": "Plugin local/privado - URL de download necessaria"
        },
        {
            "name": "block_xp",
            "description": "Level Up XP - Gamification",
            "type": "block",
            "source": "github",
            "repo": "FMCorz/moodle-block_xp",
            "version": "v18.3",
            "enabled": true
        },
        {
            "name": "tool_certificate",
            "description": "Certificate Tool - Create certificate templates",
            "type": "tool",
            "source": "github",
            "repo": "moodleworkplace/moodle-tool_certificate",
            "version": "v4.5.5",
            "enabled": true
        },
        {
            "name": "tool_dynamic_cohorts",
            "description": "Dynamic Cohorts - Auto-populate cohorts based on rules",
            "type": "tool",
            "source": "github",
            "repo": "catalyst/moodle-tool_dynamic_cohorts",
            "version": "MOODLE_404_STABLE",
            "enabled": true
        },
        {
            "name": "tool_health",
            "description": "Health Check - System diagnostics",
            "type": "tool",
            "source": "github",
            "repo": "moodlehq/moodle-tool_health",
            "version": "v1.1.2",
            "enabled": true
        },
        {
            "name": "format_designer",
            "description": "Designer Course Format",
            "type": "format",
            "source": "github",
            "repo": "bdecentgmbh/moodle-format_designer",
