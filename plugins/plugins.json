            "enabled": true
        },
        {
            "name": "format_flexsections",
            "description": "Flexible Sections Course Format",
            "type": "format",
            "source": "github",
            "repo": "marinaglancy/moodle-format_flexsections",
            "version": "v4.1.4",
            "enabled": true
        },
        {
            "name": "format_kickstart",
            "description": "Kickstart Course Format",
            "type": "format",
            "source": "github",
            "repo": "bdecentgmbh/moodle-format_kickstart",
            "version": "v1.5-r4",
            "enabled": true
        },
        {
            "name": "format_onetopic",
            "description": "Onetopic Course Format - Tabbed sections",
            "type": "format",
            "source": "github",
            "repo": "davidherney/moodle-format_onetopic",
            "version": "v4.1.10",
            "enabled": true
        },
        {
            "name": "format_popups",
            "description": "Popups Course Format",
            "type": "format",
            "source": "github",
            "repo": "dthies/moodle-format_popups",
            "version": "v1.0.22",
            "enabled": true
        },
        {
            "name": "format_remuiformat",
            "description": "RemUI Course Format - Cards/List view",
            "type": "format",
            "source": "url",
            "url": "",
            "version": "4.1.18",
            "enabled": false,
            "_comment": "Edwiser proprietary - requires license from moodle.org"
        },
        {
            "name": "format_tiles",
            "description": "Tiles Course Format - Visual tiles layout",
            "type": "format",
            "source": "github",
            "repo": "devlionco/moodle-format_tiles",
            "version": "master",
            "enabled": true
        },
        {
            "name": "theme_boost_union",
            "description": "Boost Union Theme - Extended Boost theme",
            "type": "theme",
            "source": "github",
            "repo": "moodle-an-hochschulen/moodle-theme_boost_union",
            "version": "v4.5-r29",
            "enabled": true
        },
        {
            "name": "local_copy",
            "description": "Copy Course Content - Duplicate activities",
            "type": "local",
            "source": "github",
            "repo": "EduardoKrausME/moodle-local_copy",
            "version": "1.1.12",
            "enabled": true
        },
        {
            "name": "local_ldap",
            "description": "LDAP Sync - Extended LDAP functionality",
            "type": "local",
            "source": "github",
            "repo": "LafColITS/moodle-local_ldap",
            "version": "v4.4.0",
            "enabled": true
        },
        {
            "name": "local_learningtools",
            "description": "Learning Tools - Student productivity tools",
            "type": "local",
            "source": "github",
            "repo": "bdecentgmbh/moodle-local_learningtools",
            "version": "v1.3-r3",
            "enabled": true
        },
        {
            "name": "local_recompletion",
            "description": "Recompletion - Reset course completion for re-enrollment",
            "type": "local",
            "source": "github",
            "repo": "danmarsden/moodle-local_recompletion",
            "version": "MOODLE_405_STABLE",
            "enabled": true
        }
    ],

    "settings": {
        "fail_on_error": false,
        "verify_checksums": false,
        "cleanup_after_install": true
    }
}
