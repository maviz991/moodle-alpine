# ==============================================================================
# Moodle Docker - .gitignore
# ==============================================================================

# Variáveis de ambiente (contém senhas!)
.env

# Certificados SSL
certs/
*.pem
*.key
*.crt
moodle_alpine2/config/ca

# Excecao: CAs corporativas usadas no build (certificado publico, sem chave
# privada). Necessario no repo para o build funcionar em qualquer clone.
!config/ca/*.crt

# Logs
logs/
*.log

# Dados do Moodle
moodledata/

# Backups
backups/
*.sql
*.tar.gz

# Docker volumes locais
data/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
